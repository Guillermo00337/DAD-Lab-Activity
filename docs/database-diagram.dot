digraph EquipmentBorrowingSchema {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.75", ranksep="1.0", splines=ortho, fontname="Arial", label="Campus Equipment Borrowing System — PostgreSQL schema (Activity 4)", labelloc=t, fontsize=20];
  node [shape=plain, fontname="Arial"];
  edge [fontname="Arial", fontsize=10, color="#475569", penwidth=1.5, arrowsize=0.8];

  Students [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#1D4ED8" COLSPAN="3"><FONT COLOR="white"><B>Students</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>Id</B></TD><TD><FONT COLOR="#1D4ED8">PK</FONT></TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD ALIGN="LEFT">StudentNumber</TD><TD><FONT COLOR="#1D4ED8">UQ*</FONT></TD><TD ALIGN="LEFT">varchar(40)</TD></TR>
      <TR><TD ALIGN="LEFT">FullName</TD><TD></TD><TD ALIGN="LEFT">varchar(150)</TD></TR>
      <TR><TD ALIGN="LEFT">ContactInformation</TD><TD></TD><TD ALIGN="LEFT">nullable</TD></TR>
      <TR><TD ALIGN="LEFT">IsAllowedToBorrow</TD><TD></TD><TD ALIGN="LEFT">boolean</TD></TR>
      <TR><TD ALIGN="LEFT">MaxActiveBorrowings</TD><TD></TD><TD ALIGN="LEFT">integer (0–3)</TD></TR>
    </TABLE>
  >];

  Borrowings [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#0F766E" COLSPAN="3"><FONT COLOR="white"><B>Borrowings</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>Id</B></TD><TD><FONT COLOR="#0F766E">PK</FONT></TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD ALIGN="LEFT">StudentId</TD><TD><FONT COLOR="#0F766E">FK</FONT></TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD ALIGN="LEFT">EquipmentId</TD><TD><FONT COLOR="#0F766E">FK</FONT></TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD ALIGN="LEFT">DateBorrowed</TD><TD></TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD ALIGN="LEFT">ExpectedReturnDate</TD><TD></TD><TD ALIGN="LEFT">date</TD></TR>
      <TR><TD ALIGN="LEFT">DateReturned</TD><TD></TD><TD ALIGN="LEFT">nullable date</TD></TR>
      <TR><TD ALIGN="LEFT">Status</TD><TD></TD><TD ALIGN="LEFT">integer (0/1)</TD></TR>
    </TABLE>
  >];

  Equipment [label=<
    <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7">
      <TR><TD BGCOLOR="#7E22CE" COLSPAN="3"><FONT COLOR="white"><B>Equipment</B></FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><B>Id</B></TD><TD><FONT COLOR="#7E22CE">PK</FONT></TD><TD ALIGN="LEFT">integer</TD></TR>
      <TR><TD ALIGN="LEFT">AssetTag</TD><TD><FONT COLOR="#7E22CE">UQ*</FONT></TD><TD ALIGN="LEFT">varchar(50)</TD></TR>
      <TR><TD ALIGN="LEFT">Name</TD><TD></TD><TD ALIGN="LEFT">varchar(150)</TD></TR>
      <TR><TD ALIGN="LEFT">Description</TD><TD></TD><TD ALIGN="LEFT">nullable varchar(300)</TD></TR>
      <TR><TD ALIGN="LEFT">IsAvailable</TD><TD></TD><TD ALIGN="LEFT">boolean</TD></TR>
    </TABLE>
  >];
  Students -> Borrowings [label="1 to many", arrowhead=normal];
  Equipment -> Borrowings [label="1 to many", arrowhead=normal];
}
