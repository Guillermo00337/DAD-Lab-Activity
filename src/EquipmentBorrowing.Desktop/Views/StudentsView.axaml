<UserControl
    x:Class="EquipmentBorrowing.Desktop.Views.StudentsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:DataType="vm:StudentsViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="domain:Student">
      <StackPanel Spacing="2" Margin="0,3">
        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" />
        <TextBlock Text="{Binding StudentNumber}" FontSize="12" Foreground="#64748B" />
        <TextBlock Text="{Binding IsAllowedToBorrow}" FontSize="11" Foreground="#64748B" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid Margin="16" ColumnDefinitions="*,360" ColumnSpacing="16">
    <Border Padding="14" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Student records" />
        <TextBlock DockPanel.Dock="Top" Text="Loading…" IsVisible="{Binding IsLoading}" />
        <ListBox Margin="0,10,0,0" ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" />
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Register / update student" />
          <TextBlock Text="Institutional number" />
          <TextBox Text="{Binding StudentNumber}" />
          <TextBlock Text="Full name" />
          <TextBox Text="{Binding FullName}" />
          <TextBlock Text="Optional contact information" />
          <TextBox Text="{Binding ContactInformation}" />
          <TextBlock Text="Eligibility is set to allowed when registering a new student; use this option for the selected student only." TextWrapping="Wrap" Foreground="#475569" />
          <CheckBox IsChecked="{Binding IsEligible}" Content="Eligible for new borrowings" />
          <Button Command="{Binding RegisterCommand}" Content="Register student" />
          <Button Command="{Binding UpdateCommand}" Content="Update selected student" />
          <Button Command="{Binding SaveEligibilityCommand}" Content="Save eligibility" />
          <Button Command="{Binding ClearFormCommand}" Content="Clear form" />
          <Button Command="{Binding LoadCommand}" Content="Refresh students" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
