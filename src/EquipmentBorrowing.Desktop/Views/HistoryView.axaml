<UserControl
    x:Class="EquipmentBorrowing.Desktop.Views.HistoryView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="using:EquipmentBorrowing.Application.Services"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:DataType="vm:HistoryViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="domain:Student">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding FullName}" />
        <TextBlock Text="{Binding StudentNumber}" FontSize="11" Foreground="#64748B" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="domain:Equipment">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Name}" />
        <TextBlock Text="{Binding AssetTag}" FontSize="11" Foreground="#64748B" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="app:BorrowingHistoryItem">
      <Grid ColumnDefinitions="55,*,*,105,105,105,85" ColumnSpacing="8" Margin="0,3">
        <TextBlock Text="{Binding BorrowingId}" />
        <TextBlock Grid.Column="1" Text="{Binding StudentName}" />
        <TextBlock Grid.Column="2" Text="{Binding EquipmentName}" />
        <TextBlock Grid.Column="3" Text="{Binding DateBorrowed}" />
        <TextBlock Grid.Column="4" Text="{Binding ExpectedReturnDate}" />
        <TextBlock Grid.Column="5" Text="{Binding DateReturned}" />
        <TextBlock Grid.Column="6" Text="{Binding Status}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
    <StackPanel Spacing="3">
      <TextBlock FontSize="21" FontWeight="SemiBold" Text="Borrowing history" />
      <TextBlock Text="Loading selected history…" IsVisible="{Binding IsLoading}" Foreground="#64748B" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*,Auto,Auto" ColumnSpacing="8">
      <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" />
      <Button Grid.Column="1" Command="{Binding LoadStudentHistoryCommand}" Content="Student history" />
      <ComboBox Grid.Column="2" ItemsSource="{Binding EquipmentItems}" SelectedItem="{Binding SelectedEquipment}" />
      <Button Grid.Column="3" Command="{Binding LoadEquipmentHistoryCommand}" Content="Equipment history" />
      <Button Grid.Column="4" Command="{Binding LoadCommand}" Content="Refresh" />
    </Grid>
    <Border Grid.Row="2" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="55,*,*,105,105,105,85" ColumnSpacing="8">
          <TextBlock Text="ID" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Student" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Equipment" FontWeight="SemiBold" />
          <TextBlock Grid.Column="3" Text="Checkout" FontWeight="SemiBold" />
          <TextBlock Grid.Column="4" Text="Due" FontWeight="SemiBold" />
          <TextBlock Grid.Column="5" Text="Returned" FontWeight="SemiBold" />
          <TextBlock Grid.Column="6" Text="Status" FontWeight="SemiBold" />
        </Grid>
        <ListBox Margin="0,8,0,0" ItemsSource="{Binding History}" />
      </DockPanel>
    </Border>
    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
  </Grid>
</UserControl>
