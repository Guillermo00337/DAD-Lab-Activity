<UserControl
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentManagementView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:DataType="vm:EquipmentManagementViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="domain:Equipment">
      <Grid ColumnDefinitions="100,*,*,90" ColumnSpacing="8" Margin="0,3">
        <TextBlock Text="{Binding AssetTag}" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" />
        <TextBlock Grid.Column="2" Text="{Binding Description}" />
        <TextBlock Grid.Column="3" Text="{Binding IsAvailable}" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>
  <Grid Margin="16" ColumnDefinitions="*,360" ColumnSpacing="16">
    <Border Padding="14" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold" Text="Equipment catalog (UC-01)" />
        <TextBlock DockPanel.Dock="Top" Text="Loading…" IsVisible="{Binding IsLoading}" />
        <ListBox Margin="0,10,0,0" ItemsSource="{Binding EquipmentItems}" SelectedItem="{Binding SelectedEquipment}" />
      </DockPanel>
    </Border>
    <Border Grid.Column="1" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock FontSize="18" FontWeight="SemiBold" Text="Register / update equipment" />
          <TextBlock Text="Equipment identifier" />
          <TextBox Text="{Binding Identifier}" />
          <TextBlock Text="Name" />
          <TextBox Text="{Binding Name}" />
          <TextBlock Text="Optional description / type" />
          <TextBox Text="{Binding Description}" AcceptsReturn="True" MinHeight="70" />
          <TextBlock Text="Availability is controlled only by borrowing and return operations." TextWrapping="Wrap" Foreground="#475569" />
          <Button Command="{Binding RegisterCommand}" Content="Register equipment" />
          <Button Command="{Binding UpdateCommand}" Content="Update selected equipment" />
          <Button Command="{Binding ClearFormCommand}" Content="Clear form" />
          <Button Command="{Binding LoadCommand}" Content="Refresh equipment" />
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
