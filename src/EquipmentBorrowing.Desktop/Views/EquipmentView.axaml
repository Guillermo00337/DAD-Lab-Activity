<UserControl
    x:Class="EquipmentBorrowing.Desktop.Views.EquipmentView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="using:EquipmentBorrowing.Domain"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:DataType="vm:EquipmentViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="domain:Student">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding FullName}" />
        <TextBlock Text="{Binding StudentNumber}" FontSize="11" Foreground="#64748B" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="domain:Equipment">
      <StackPanel Spacing="2">
        <TextBlock Text="{Binding Name}" />
        <TextBlock Text="{Binding AssetTag}" FontSize="11" Foreground="#64748B" />
      </StackPanel>
    </DataTemplate>
  </UserControl.DataTemplates>
  <ScrollViewer>
    <Grid Margin="16" RowDefinitions="Auto,Auto,*" RowSpacing="14">
      <StackPanel Spacing="4">
        <TextBlock FontSize="21" FontWeight="SemiBold" Text="Borrow equipment" />
        <TextBlock Text="Loading catalog…" IsVisible="{Binding IsLoading}" Foreground="#64748B" />
        <TextBlock Text="Select an eligible student, a checkout date (today), and an expected return date later than today." />
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Padding="16" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="10">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Single-item checkout (UC-03)" />
            <TextBlock Text="Student" />
            <ComboBox ItemsSource="{Binding Students}" SelectedItem="{Binding SelectedStudent}" />
            <TextBlock Text="Available equipment (UC-02)" />
            <ComboBox ItemsSource="{Binding AvailableEquipment}" SelectedItem="{Binding SelectedEquipment}" />
            <TextBlock Text="Expected return date" />
            <DatePicker SelectedDate="{Binding ExpectedReturnDate}" />
            <Button HorizontalAlignment="Left" Command="{Binding BorrowCommand}" Content="Borrow selected item" />
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Padding="16" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8">
          <StackPanel Spacing="10">
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Multi-item checkout (UC-06)" />
            <TextBlock Text="Use the same student and return date. Select at least two distinct available items." TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding MultiItemChoices}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EquipmentChoice">
                  <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                  </CheckBox>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button HorizontalAlignment="Left" Command="{Binding BorrowMultipleCommand}" Content="Check out selected items" />
          </StackPanel>
        </Border>
      </Grid>
      <Border Grid.Row="2" Padding="12" Background="#F1F5F9" CornerRadius="8">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button Command="{Binding LoadCommand}" Content="Refresh data" />
          <TextBlock VerticalAlignment="Center" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
