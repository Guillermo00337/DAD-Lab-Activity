<Window
    x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:EquipmentBorrowing.Desktop.Views"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    Title="Campus Equipment Borrowing System"
    Width="1180"
    Height="780"
    MinWidth="940"
    MinHeight="640">
  <Grid RowDefinitions="Auto,*">
    <Border Background="#1F2937" Padding="24,18">
      <StackPanel Spacing="3">
        <TextBlock Foreground="White" FontSize="22" FontWeight="SemiBold" Text="Campus Equipment Borrowing System" />
        <TextBlock Foreground="#D1D5DB" FontSize="12" Text="Laboratory staff workspace • PostgreSQL database" />
      </StackPanel>
    </Border>
    <TabControl Grid.Row="1" Margin="16">
      <TabItem Header="Borrow equipment">
        <views:EquipmentView DataContext="{Binding BorrowEquipment}" />
      </TabItem>
      <TabItem Header="Borrowings / Search">
        <views:BorrowingsView DataContext="{Binding Borrowings}" />
      </TabItem>
      <TabItem Header="Students">
        <views:StudentsView DataContext="{Binding Students}" />
      </TabItem>
      <TabItem Header="Equipment management">
        <views:EquipmentManagementView DataContext="{Binding EquipmentManagement}" />
      </TabItem>
      <TabItem Header="History">
        <views:HistoryView DataContext="{Binding Histories}" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
