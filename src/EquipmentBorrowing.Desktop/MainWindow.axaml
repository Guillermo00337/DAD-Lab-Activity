<Window
    x:Class="EquipmentBorrowing.Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EquipmentBorrowing.Desktop.ViewModels"
    xmlns:views="using:EquipmentBorrowing.Desktop.Views"
    x:DataType="vm:MainWindowViewModel"
    Title="Campus Equipment Borrowing System"
    Width="1040"
    Height="680"
    MinWidth="860"
    MinHeight="560">

  <Window.DataTemplates>
    <DataTemplate DataType="vm:EquipmentViewModel">
      <views:EquipmentView />
    </DataTemplate>
    <DataTemplate DataType="vm:BorrowingsViewModel">
      <views:BorrowingsView />
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <Border Background="#1F2937" Padding="24,18">
      <TextBlock
          Classes="Heading"
          Foreground="White"
          Text="Campus Equipment Borrowing System" />
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="220,*">
      <Border Background="#E8EEF6" Padding="16">
        <StackPanel Spacing="10">
          <TextBlock Classes="Label" Text="Sections" />
          <Button
              Classes="Nav"
              Command="{Binding ShowEquipmentCommand}"
              Content="Equipment" />
          <Button
              Classes="Nav"
              Command="{Binding ShowBorrowingsCommand}"
              Content="Active Borrowings" />
        </StackPanel>
      </Border>

      <ContentControl
          Grid.Column="1"
          Margin="20"
          Content="{Binding CurrentViewModel}" />
    </Grid>
  </Grid>
</Window>
