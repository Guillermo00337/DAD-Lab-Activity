<Application
    x:Class="EquipmentBorrowing.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EquipmentBorrowing.Desktop"
    RequestedThemeVariant="Light">

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://EquipmentBorrowing.Desktop/Styles.axaml" />
  </Application.Styles>
</Application>
